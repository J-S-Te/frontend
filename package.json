{
  "name": "basic-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node src/test/run-tests.mjs",
    "check:vue": "node scripts/check-vue-components.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:negative": "node scripts/typecheck-negative.mjs",
    "test:vue-lifecycle": "node src/test/ui-harness/vue-lifecycle-browser.mjs",
    "test:layout": "node src/test/ui-harness/responsive-boundaries-browser.mjs",
    "build": "vite build",
    "verify:modules": "node build/verifyModuleSelection.mjs",
    "audit:design-tokens": "node scripts/audit-design-tokens.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vant/area-data": "2.2.0",
    "node-forge": "1.4.2",
    "pdfjs-dist": "6.4.299",
    "pinyin-pro": "^3.29.2",
    "read-excel-file": "^9.3.14",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "3.3.14"
  }
}
