{
  "name": "basic-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node src/test/run-tests.mjs",
    "check:vue": "node scripts/check-vue-components.mjs",
    "typecheck": "vue-tsc --noEmit -p tsconfig.typecheck.json",
    "typecheck:negative": "node scripts/typecheck-negative.mjs",
    "test:vue-lifecycle": "node src/test/ui-harness/vue-lifecycle-browser.mjs",
    "test:layout": "node src/test/ui-harness/responsive-boundaries-browser.mjs",
    "test:local-ui": "node src/test/ui-harness/local-fixes-browser.mjs",
    "test:e2e": "e2e run",
    "e2e": "bash scripts/e2e.sh",
    "e2e:smoke": "bash scripts/e2e.sh run --tag smoke",
    "e2e:full": "APP_URL=http://localhost:8081 E2E_SERVER=external E2E_VISUAL=1 bash scripts/e2e.sh run --exclude-tag online",
    "e2e:online": "E2E_ONLINE=1 E2E_ONLINE_SIGNIN=1 APP_URL=${APP_URL:-https://47.111.20.119:18081} E2E_SERVER=external bash scripts/e2e.sh run --tag online",
    "e2e:browser": "bash scripts/e2e-browser.sh",
    "build": "vite build",
    "verify:modules": "node build/verifyModuleSelection.mjs",
    "audit:design-tokens": "node scripts/audit-design-tokens.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vant/area-data": "2.2.0",
    "node-forge": "1.4.2",
    "pdfjs-dist": "6.4.299",
    "pinyin-pro": "^3.29.2",
    "read-excel-file": "^9.3.14",
    "vue": "^3.5.42",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@e2e-dev/web": "^0.16.1",
    "@midscene/web": "^1.18.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "e2e": "^0.24.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.65.1",
    "playwright-core": "^1.63.0",
    "typescript": "5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "3.3.14"
  }
}
