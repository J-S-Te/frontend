# 此文件由 nginx 官方 entrypoint 使用受限变量集生成。
# HTTP 是缺省模式，不引用任何证书路径。
server {
    listen 80 default_server;
    server_name ${PUBLIC_PLATFORM_HOST};
    client_max_body_size 25m;

    # SEC-N9：不暴露 nginx 版本号。
    server_tokens off;
    # SEC-N9：网关层兜底通用 50x 错误页，避免依赖后端错误页，
    # 也不向客户端回显默认错误页中的版本/调试信息。
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        internal;
        root /usr/share/nginx/html;
        default_type text/html;
    }

    location /file-gateway/api/v2/ {
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 10m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://127.0.0.1:8088;
    }

    location ~ ^/api/v1/subsystem-(onboarding|update|retry|teardown)$ {
        proxy_connect_timeout 30s;
        proxy_send_timeout 960s;
        proxy_read_timeout 960s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://127.0.0.1:8088;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://127.0.0.1:8088;
    }
}

server {
    listen 80;
    server_name ${PUBLIC_SSO_HOST};

    # SEC-N9：不暴露 nginx 版本号。
    server_tokens off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $keycloak_backend keycloak:8080;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto http;
        proxy_pass http://$keycloak_backend;
    }
}
