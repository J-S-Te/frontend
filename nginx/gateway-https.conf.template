# HTTPS 模式只引用容器内固定只读挂载点；宿主机真实路径不会写进生成配置。
server {
    listen 80 default_server;
    server_name ${PUBLIC_PLATFORM_HOST} ${PUBLIC_SSO_HOST};

    # AUD-2026-023：跳转服务器同样会以 $request 记录完整 query（含票据）——票据地址
    # 若经 http 变体到达会先落在这里。为文件网关前缀声明同语义的 308 跳转 + 不含 query
    # 的日志（log_format file_gateway_noquery 定义于 default.conf，同 http 上下文），
    # 其余路径仍沿用服务器级 return，不受影响。
    location /file-gateway/ {
        access_log /var/log/nginx/access.log file_gateway_noquery;
        return 308 https://$host$request_uri;
    }

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl default_server;
    http2 on;
    server_name ${PUBLIC_PLATFORM_HOST};
    server_tokens off;
    client_max_body_size 25m;

    ssl_certificate /run/tls/platform.crt;
    ssl_certificate_key /run/tls/platform.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:platform_tls:10m;
    ssl_session_timeout 1d;
    # SEC-N9：HSTS 从 300 秒（5 分钟，形同虚设）提升为 1 年并覆盖子域。
    # 启用前提（本模板已满足）：HSTS 只在 443 server 发出，HTTP 入口只做 308 跳转；
    # includeSubDomains 要求 PUBLIC_PLATFORM_HOST 及其所有子域都稳定提供 HTTPS
    # （同模板内的 SSO 主机已是 443）。若未来新增子域无法保证 HTTPS，
    # 必须去掉 includeSubDomains，否则该子域将被浏览器强制 HTTPS。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /file-gateway/api/v2/ {
        # AUD-2026-023：下载票据经 URL 查询参数传递（?ticket=...），默认 access log 的
        # $request 会把整条 query 写入日志。本 location 单独使用不含 query 的日志格式
        # （log_format file_gateway_noquery 定义于 default.conf，同 http 上下文），仅作用
        # 于文件网关路径；其余 location 仍沿用默认格式，不受影响。参数级排查依赖
        # File Gateway 自身访问审计。
        # 本服务器未配置 error_page，nginx 自产的 5xx 不会内部跳转出本 location，
        # 故无需专用错误页；若未来添加服务器级 error_page，必须同时为文件网关配置
        # 脱敏错误页（参照 default.conf / gateway-http 的 /fg_50x.html）。
        access_log /var/log/nginx/access.log file_gateway_noquery;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 10m;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8088;
    }

    location ~ ^/api/v1/subsystem-(onboarding|update|retry|teardown)$ {
        proxy_connect_timeout 30s;
        proxy_send_timeout 960s;
        proxy_read_timeout 960s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8088;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://127.0.0.1:8088;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PUBLIC_SSO_HOST};
    server_tokens off;

    resolver 127.0.0.11 valid=10s ipv6=off;
    set $keycloak_backend keycloak:8080;

    ssl_certificate /run/tls/sso.crt;
    ssl_certificate_key /run/tls/sso.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:sso_tls:10m;
    ssl_session_timeout 1d;
    # SEC-N9：与平台 443 入口一致，HSTS 1 年 + 子域（SSO 自身即 HTTPS，前提成立）。
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://$keycloak_backend;
    }
}
