# 后端 API 根路径；同源部署时保留默认值。
# - vite dev server 会把 /api、/authorize、/oauth2、/.well-known 代理到 VITE_API_PROXY_TARGET
# - 如果改成绝对 URL（例如 https://portal.example.com/api/v1），浏览器会直接跨域请求，
#   此时 dev 代理不再生效；需要后端 CORS 放行。
VITE_API_BASE_URL=/api/v1

# vite dev 模式下后端地址。默认 http://127.0.0.1:8080；联调远程后端时改成对应地址。
# 仅影响 dev/preview server 的反向代理，不影响生产构建产物。
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# 合同系统后端使用独立同源前缀。生产环境由 Nginx 将其中的 /api、/auth、healthz
# 转发到 contract-api；Vite dev/preview 则使用下面的独立代理目标。
VITE_CONTRACT_PUBLIC_PATH_PREFIX=/contract_management
VITE_CONTRACT_API_BASE_URL=/contract_management/api/v1
VITE_CONTRACT_API_PROXY_TARGET=http://127.0.0.1:8081

# 客户与商机 CRM 及客户 Portal 是两个独立后端。Vite 保留公共路径前缀后
# 分别代理到 8090/8091；生产环境由网关做同样的路径路由。
VITE_CRM_PUBLIC_PATH_PREFIX=/customer-opportunity
VITE_CRM_API_BASE_URL=/customer-opportunity/api/v1
VITE_CUSTOMER_OPPORTUNITY_PROXY_TARGET=http://127.0.0.1:18083
VITE_CUSTOMER_PORTAL_PUBLIC_PATH_PREFIX=/customer-portal
VITE_CUSTOMER_PORTAL_API_BASE_URL=/customer-portal/api/v1
VITE_CUSTOMER_PORTAL_PROXY_TARGET=http://127.0.0.1:8091

# 数据分析后端保留 /data_analysis 公共前缀。Vite 只代理其 API、会话和健康检查路径，
# 页面仍由统一 Vue 应用处理。默认 dashboard-api 在本机 8080 监听。
VITE_DATA_ANALYSIS_PUBLIC_PATH_PREFIX=/data_analysis
VITE_DATA_ANALYSIS_API_BASE_URL=/data_analysis/api/v1
VITE_DATA_ANALYSIS_PROXY_TARGET=http://127.0.0.1:8080

# 无 return_to 参数时的登录成功落点。
VITE_LOGIN_SUCCESS_URL=/
